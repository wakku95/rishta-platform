{
  "expo": {
    "name": "RaabtaNow",
    "slug": "raabtanow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111827",
    "splash": {
      "image": "./assets/splash-logo-square.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.raabtanow.app",
      "infoPlist": {
        "NSCameraUsageDescription": "RaabtaNow needs camera access to capture your live selfie and CNIC for authentic matrimonial identity verification.",
        "NSPhotoLibraryUsageDescription": "RaabtaNow needs access to photos to select your CNIC documents."
      }
    },
    "android": {
      "package": "com.raabtanow.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#111827",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "splash": {
        "image": "./assets/splash-logo-square.png",
        "resizeMode": "contain",
        "backgroundColor": "#111827"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#e11d48"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111827",
          "image": "./assets/splash-logo-square.png",
          "dark": {
            "image": "./assets/splash-logo-square.png",
            "backgroundColor": "#111827"
          },
          "imageWidth": 240
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a7697117-62ca-4e04-9687-74737864b772"
      }
    }
  }
}
